// CertForge AI - primary database schema.
// Every schema change must produce a migration (prisma migrate dev).
// See docs/architecture/data-model.md for the rationale behind these models.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum CertificationVersionStatus {
  draft
  active
  deprecated
}

enum QuestionType {
  single_choice
  multiple_response
}

enum QuestionDifficulty {
  easy
  medium
  hard
  expert
}

enum QuestionLifecycleState {
  generated
  validated
  approved
  flagged
  quarantined
  retired
}

enum ValidatorVerdict {
  approved
  repair_needed
  quarantined
}

enum LLMProviderKind {
  anthropic
  openai
  google
  openrouter
  custom
}

enum GenerationJobKind {
  exam_assembly
  manual_generation
  repair
}

enum GenerationJobStatus {
  queued
  planning
  generating
  validating
  repairing
  assembling
  completed
  failed
}

enum ExamMode {
  official_simulation
  practice
}

enum ExamAttemptStatus {
  not_started
  in_progress
  paused
  submitted
  expired
  abandoned
}

enum ExamEventType {
  started
  navigated
  answered
  flagged
  unflagged
  paused
  resumed
  submitted
  expired
}

enum QuestionFeedbackRating {
  good
  poor
  possibly_incorrect
}

// ---------------------------------------------------------------------------
// Application / identity
// ---------------------------------------------------------------------------

/// Local candidate/admin profile. V1 is single-user-per-install; the model
/// still has its own identity so multi-profile/multi-user is additive later.
model User {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  displayName String
  email       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  examAttempts     ExamAttempt[]
  questionFeedback QuestionFeedback[]
  providerConfigs  LLMProviderConfig[]

  @@map("users")
}

/// Generic key/value store for application state that isn't its own entity -
/// e.g. "setup.completed" = "true". Deliberately simple; see
/// docs/architecture/architecture-overview.md for why this was chosen over
/// a dedicated SetupState table.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ---------------------------------------------------------------------------
// Certification engine
// ---------------------------------------------------------------------------

/// Stable certification identity (e.g. "claude-architect-foundations").
model Certification {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  versions CertificationVersion[]

  @@map("certifications")
}

/// Immutable blueprint snapshot imported from a certification pack. Once any
/// ExamAttempt references a version, isLocked becomes true and its domains/
/// objectives/timing must never be mutated - only a new version may change them.
model CertificationVersion {
  id               String                      @id @default(cuid())
  certificationId  String
  version          String
  status           CertificationVersionStatus  @default(draft)
  examName         String
  totalQuestions   Int
  durationMinutes  Int
  passingScore     Int?
  scoreScaleMin    Int?
  scoreScaleMax    Int?
  questionTypes    QuestionType[]
  sourceDisclaimer String
  isLocked         Boolean                     @default(false)
  publishedAt      DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  certification  Certification   @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  domains        Domain[]
  scenarios      Scenario[]
  questions      Question[]
  examAttempts   ExamAttempt[]
  generationJobs GenerationJob[]

  @@unique([certificationId, version])
  @@index([certificationId, status])
  @@map("certification_versions")
}

model Domain {
  id                     String   @id @default(cuid())
  certificationVersionId String
  key                    String
  name                   String
  description            String?
  weightPercent          Float
  targetQuestionCount    Int
  minQuestionCount       Int
  maxQuestionCount       Int
  order                  Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  certificationVersion CertificationVersion @relation(fields: [certificationVersionId], references: [id], onDelete: Cascade)
  objectives           Objective[]
  scenarios            Scenario[]
  questions            Question[]
  examQuestions        ExamQuestion[]
  domainResults        DomainResult[]

  @@unique([certificationVersionId, key])
  @@index([certificationVersionId])
  @@map("domains")
}

/// Testable knowledge/skill objective under a domain. isPlaceholder marks
/// objectives whose detailed content has not yet been sourced from an
/// authoritative exam guide - the UI must visibly label these.
model Objective {
  id            String   @id @default(cuid())
  domainId      String
  code          String
  title         String
  description   String?
  isPlaceholder Boolean  @default(false)
  order         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  domain        Domain         @relation(fields: [domainId], references: [id], onDelete: Cascade)
  questions     Question[]
  examQuestions ExamQuestion[]
  domainResults DomainResult[]

  @@unique([domainId, code])
  @@index([domainId])
  @@map("objectives")
}

model Scenario {
  id                     String   @id @default(cuid())
  certificationVersionId String
  domainId               String?
  title                  String
  narrative              String
  tags                   String[]
  provider               String?
  model                  String?
  createdAt              DateTime @default(now())

  certificationVersion CertificationVersion @relation(fields: [certificationVersionId], references: [id], onDelete: Cascade)
  domain               Domain?              @relation(fields: [domainId], references: [id], onDelete: SetNull)
  questions            Question[]

  @@index([certificationVersionId])
  @@map("scenarios")
}

// ---------------------------------------------------------------------------
// Question bank
// ---------------------------------------------------------------------------

model Question {
  id                     String                 @id @default(cuid())
  certificationVersionId String
  domainId               String
  objectiveId            String
  scenarioId             String?
  type                   QuestionType
  difficulty             QuestionDifficulty
  stem                   String
  rationale              String
  /// Keyed by QuestionOption.id -> explanation of why that distractor is wrong.
  distractorRationales   Json
  tags                   String[]
  status                 QuestionLifecycleState @default(generated)
  // --- provenance (required for every AI-generated question) ---
  provider               String
  model                  String
  promptVersion          String
  generatedAt            DateTime
  validatorStatus        ValidatorVerdict?
  validatorConfidence    Float?
  qualityScore           Float?
  timesServed            Int                    @default(0)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  certificationVersion CertificationVersion @relation(fields: [certificationVersionId], references: [id], onDelete: Cascade)
  domain               Domain               @relation(fields: [domainId], references: [id], onDelete: Restrict)
  objective            Objective            @relation(fields: [objectiveId], references: [id], onDelete: Restrict)
  scenario             Scenario?            @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  options              QuestionOption[]
  validations          QuestionValidation[]
  examQuestions        ExamQuestion[]
  feedback             QuestionFeedback[]

  @@index([certificationVersionId, status])
  @@index([domainId])
  @@index([objectiveId])
  @@map("questions")
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  label      String
  text       String
  isCorrect  Boolean
  order      Int

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, label])
  @@index([questionId])
  @@map("question_options")
}

/// Independent reviewer verdict + provenance for a generated question.
model QuestionValidation {
  id                String           @id @default(cuid())
  questionId        String
  validatorProvider String
  validatorModel    String
  verdict           ValidatorVerdict
  confidence        Float
  issues            String[]
  reviewedAt        DateTime         @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("question_validations")
}

model QuestionFeedback {
  id            String                 @id @default(cuid())
  questionId    String
  examAttemptId String?
  userId        String?
  rating        QuestionFeedbackRating
  comment       String?
  createdAt     DateTime               @default(now())

  question    Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  examAttempt ExamAttempt? @relation(fields: [examAttemptId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([questionId])
  @@map("question_feedback")
}

// ---------------------------------------------------------------------------
// LLM provider configuration
// ---------------------------------------------------------------------------

/// API credentials are stored ONLY as encryptedApiKey (AES-256-GCM ciphertext).
/// maskedApiKeyPreview is the only representation ever returned to the UI
/// after initial save (see @certforge/llm-gateway security module).
model LLMProviderConfig {
  id                  String          @id @default(cuid())
  userId              String?
  provider            LLMProviderKind
  label               String
  baseUrl             String?
  model               String
  encryptedApiKey     String
  maskedApiKeyPreview String
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([provider, isActive])
  @@map("llm_provider_configs")
}

model GenerationJob {
  id                     String              @id @default(cuid())
  certificationVersionId String
  kind                   GenerationJobKind
  status                 GenerationJobStatus @default(queued)
  requestedCount         Int
  approvedCount          Int                 @default(0)
  quarantinedCount       Int                 @default(0)
  errorMessage           String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  completedAt            DateTime?

  certificationVersion CertificationVersion @relation(fields: [certificationVersionId], references: [id], onDelete: Cascade)

  @@index([certificationVersionId, status])
  @@map("generation_jobs")
}

// ---------------------------------------------------------------------------
// Exam engine
// ---------------------------------------------------------------------------

model ExamAttempt {
  id                     String            @id @default(cuid())
  userId                 String
  certificationVersionId String
  mode                   ExamMode
  status                 ExamAttemptStatus @default(not_started)
  /// Immutable snapshot of the ExamPlan used to assemble this attempt.
  examPlan               Json
  durationMinutes        Int
  activeSeconds          Int               @default(0)
  pausedSeconds          Int               @default(0)
  startedAt              DateTime?
  submittedAt            DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  certificationVersion CertificationVersion @relation(fields: [certificationVersionId], references: [id], onDelete: Restrict)
  examQuestions        ExamQuestion[]
  answers              ExamAnswer[]
  events               ExamEvent[]
  result               AttemptResult?
  feedback             QuestionFeedback[]

  @@index([userId, status])
  @@index([certificationVersionId])
  @@map("exam_attempts")
}

/// Ordered, immutable snapshot of a question as served within one attempt.
model ExamQuestion {
  id            String @id @default(cuid())
  examAttemptId String
  questionId    String
  order         Int
  domainId      String
  objectiveId   String

  examAttempt ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)
  domain      Domain      @relation(fields: [domainId], references: [id], onDelete: Restrict)
  objective   Objective   @relation(fields: [objectiveId], references: [id], onDelete: Restrict)
  answer      ExamAnswer?

  @@unique([examAttemptId, order])
  @@index([examAttemptId])
  @@map("exam_questions")
}

model ExamAnswer {
  id                String    @id @default(cuid())
  examAttemptId     String
  examQuestionId    String    @unique
  selectedOptionIds String[]
  isFlagged         Boolean   @default(false)
  firstAnsweredAt   DateTime?
  lastUpdatedAt     DateTime  @updatedAt

  examAttempt  ExamAttempt  @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  examQuestion ExamQuestion @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)

  @@index([examAttemptId])
  @@map("exam_answers")
}

/// Navigation/pause/resume/flag/submit audit trail for one attempt.
model ExamEvent {
  id            String        @id @default(cuid())
  examAttemptId String
  type          ExamEventType
  payload       Json
  occurredAt    DateTime      @default(now())

  examAttempt ExamAttempt @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)

  @@index([examAttemptId, occurredAt])
  @@map("exam_events")
}

model AttemptResult {
  id                   String   @id @default(cuid())
  examAttemptId        String   @unique
  rawScore             Int
  rawTotal             Int
  rawPercentage        Float
  /// Always presented in the UI as an estimate, never as an official score.
  estimatedScaledScore Int?
  passTargetMet        Boolean?
  computedAt           DateTime @default(now())

  examAttempt   ExamAttempt    @relation(fields: [examAttemptId], references: [id], onDelete: Cascade)
  domainResults DomainResult[]

  @@map("attempt_results")
}

model DomainResult {
  id              String  @id @default(cuid())
  attemptResultId String
  domainId        String
  objectiveId     String?
  correctCount    Int
  totalCount      Int

  attemptResult AttemptResult @relation(fields: [attemptResultId], references: [id], onDelete: Cascade)
  domain        Domain        @relation(fields: [domainId], references: [id], onDelete: Restrict)
  objective     Objective?    @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  @@index([attemptResultId])
  @@map("domain_results")
}
