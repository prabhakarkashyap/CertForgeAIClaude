# ---------------------------------------------------------------------------
# CertForge AI - environment configuration template
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://certforge:certforge@localhost:5432/certforge_ai?schema=public"

# --- Application ------------------------------------------------------------
# Base URL the app is served from. Keep bound to localhost unless you have
# deliberately secured remote access.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# 32-byte (256-bit) master key used to derive per-secret encryption keys for
# provider API credentials (AES-256-GCM). Generate with:
#   openssl rand -base64 32
# If unset, the app generates and persists one to a local, git-ignored file
# under the app data directory on first run (see docs/architecture/llm-provider-design.md).
APP_ENCRYPTION_KEY=""

# Directory used for local application data (encryption key material,
# generated exports, logs). Must be writable by the process.
APP_DATA_DIR="./.data"

# --- LLM Providers ------------------------------------------------------------
# Provider credentials are NOT configured via environment variables in normal
# operation - they are entered through the setup wizard / admin UI and stored
# encrypted in PostgreSQL. These variables exist only to support local
# scripting/testing convenience and CI. Never commit real keys here.
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# GOOGLE_API_KEY=""
# OPENROUTER_API_KEY=""
